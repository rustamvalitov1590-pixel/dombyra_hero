# Google Gemini API Key for Nurali AI Assistant
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Or from Google Cloud Console (Generative Language API)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key for Nurali's natural boy voice (Multilingual v2 - Russian & Kazakh)
# Get your key from https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional: custom Voice ID (defaults to Antoni / Sam / youthful boy voice)
ELEVENLABS_VOICE_ID=ErXwobaYiN019PkySvjV

# Fallback: Google Cloud Text-to-Speech API Key (if using GCP TTS)
# GOOGLE_CLOUD_TTS_API_KEY=your_google_cloud_tts_key_here
